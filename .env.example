# これをコピーして「.env」にし、自分のキーを入れる（.env は .gitignore 済み＝コミットされない）
#   cp .env.example .env
# 各 tools/*.py は「環境変数 → .env」の順に読む。
# 重要: キーをコミット/チャットに貼らない。露出したら各サービスで必ず再発行する。
#
# Claude Code on the web（リモート実行環境）で使う場合は、.env ではなく
# 環境設定の環境変数に入れるほうが確実（コンテナは使い捨てなので .env は消える）。
#   https://code.claude.com/docs/en/claude-code-on-the-web
#
# ★キーだけでは足りない。ネットワークポリシーで各APIのホストが許可されている必要がある。
#   2026-07-28 の実測（curl で疎通確認）:
#     generativelanguage.googleapis.com … 到達可
#     api.elevenlabs.io / api.pixai.art / api.openai.com / api.replicate.com
#     api.stability.ai / fal.run        … 遮断（403）
#   遮断されているものは、先に環境のネットワークポリシーを緩める必要がある。

# ── 画像・スプライト生成（Gemini）────────────────────────────────────
# 使うツール: gen_anim_frames_gemini.py / gen_sprite_gemini.py / gen_sprite_nano.py
#            gen_sprite_sheet_gemini.py / gen_sprites_template.py / gen_face_gemini.py
# GOOGLE_API_KEY でも可（GEMINI_API_KEY が優先）。
# これが入れば docs/BACKLOG.md の A（等身のばらつき・背面スプライト）が着手できる。
GEMINI_API_KEY=

# ── 立ち絵・表情差分（PixAI）─────────────────────────────────────────
# 使うツール: gen_face_*.py / gen_portraits.py / gen_sprite.py
PIXAI_API_KEY=
# 任意: 既定モデルIDを決めておくと --model 省略時に使われる
PIXAI_MODEL_ID=

# ── ボイス・効果音（ElevenLabs）──────────────────────────────────────
# 使うツール: gen_audio_elevenlabs.py
ELEVENLABS_API_KEY=

# ── 動画生成・音楽生成 ───────────────────────────────────────────────
# 対応ツールはまだこのリポジトリに無い。必要になったら tools/ に足す。
# BGM は現状 tools/gen_audio_proc.py の手続き生成と ElevenLabs で作っている。
